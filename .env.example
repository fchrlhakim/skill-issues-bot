APP_ENV=local
APP_NAME=skill-issues-bot
APP_PORT=8080
APP_LOG_LEVEL=debug
APP_LOG_FORMAT=text

HTTP_READ_TIMEOUT=10s
HTTP_READ_HEADER_TIMEOUT=5s
HTTP_WRITE_TIMEOUT=10s
HTTP_IDLE_TIMEOUT=60s
HTTP_SHUTDOWN_TIMEOUT=10s

CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

JWT_SECRET=change-me-to-at-least-32-random-characters
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=720h

# Database: postgres, mysql, sqlite
DB_DRIVER=postgres
DB_HOST=localhost
DB_PORT=5432
DB_NAME=starter
DB_USER=starter
DB_PASSWORD=starter
DB_SSL_MODE=disable
DB_MAX_OPEN_CONNS=10
DB_MAX_IDLE_CONNS=5
DB_CONN_MAX_LIFETIME=5m

# MySQL example:
# DB_DRIVER=mysql
# DB_HOST=localhost
# DB_PORT=3306
# DB_NAME=starter
# DB_USER=starter
# DB_PASSWORD=starter

# SQLite example:
# DB_DRIVER=sqlite
# DB_NAME=starter.db

RATE_LIMIT_RPS=10
RATE_LIMIT_BURST=20
RATE_LIMIT_BACKEND=local

REDIS_ENABLE=false
REDIS_ADDR=localhost:6379
REDIS_PASSWORD=
REDIS_DB=0

HTTP_CLIENT_TIMEOUT=10s
MAX_BODY_BYTES=1048576
MAX_MULTIPART_MEMORY=8388608

METRICS_ENABLE=true
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=storage

DISCORD_BOT_TOKEN=
DISCORD_GUILD_ID=

# Optional: enables the /revenue SaaS figures. Leave empty to keep the command
# reporting "SaaS revenue: unavailable". Never commit a real token.
# SAAS_REVENUE_URL=http://skill-issues-saas-be:8080/api/v1/admin/reports/finance-overview
#
# Preferred: a refresh token. The bot rotates it automatically, so the command
# keeps working past the 15-minute access-token lifetime. The rotated chain is
# persisted under SAAS_TOKEN_FILE and outranks this value on restart.
# SAAS_REFRESH_TOKEN=
#
# Fallback: a static access token. It expires in 15 minutes and is not renewed.
# SAAS_REVENUE_TOKEN=
#
# Overrides, normally unnecessary: SAAS_AUTH_URL is derived from SAAS_REVENUE_URL,
# and SAAS_TOKEN_FILE defaults to storage/saas-token.json.
# SAAS_AUTH_URL=
# SAAS_TOKEN_FILE=

# Production host only (docker-compose.prod.yml). Do not commit .env.production.
# GHCR_USERNAME=
# GHCR_PULL_TOKEN=

# Operator allowlist: comma-separated user ids allowed to read GET /user and
# GET /audit-logs. Those routes expose every account's email and the audit
# trail, so they fail closed — with this unset they return 403 to everyone.
# OPERATOR_USER_IDS=
#
# Comma-separated CIDRs whose X-Forwarded-For may be believed for client IP,
# rate limiting and audit. Empty (the default) trusts no proxy, which is correct
# when the service is loopback-only.
# TRUSTED_PROXIES=
