APP_ENV=local
APP_NAME=skill-issues-bot
APP_PORT=8080
APP_LOG_LEVEL=debug
APP_LOG_FORMAT=text

HTTP_READ_TIMEOUT=10s
HTTP_READ_HEADER_TIMEOUT=5s
HTTP_WRITE_TIMEOUT=10s
HTTP_IDLE_TIMEOUT=60s
HTTP_SHUTDOWN_TIMEOUT=10s

CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

JWT_SECRET=change-me-to-at-least-32-random-characters
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=720h

# Database: postgres, mysql, sqlite
DB_DRIVER=postgres
DB_HOST=localhost
DB_PORT=5432
DB_NAME=starter
DB_USER=starter
DB_PASSWORD=starter
DB_SSL_MODE=disable
DB_MAX_OPEN_CONNS=10
DB_MAX_IDLE_CONNS=5
DB_CONN_MAX_LIFETIME=5m

# MySQL example:
# DB_DRIVER=mysql
# DB_HOST=localhost
# DB_PORT=3306
# DB_NAME=starter
# DB_USER=starter
# DB_PASSWORD=starter

# SQLite example:
# DB_DRIVER=sqlite
# DB_NAME=starter.db

RATE_LIMIT_RPS=10
RATE_LIMIT_BURST=20
RATE_LIMIT_BACKEND=local

REDIS_ENABLE=false
REDIS_ADDR=localhost:6379
REDIS_PASSWORD=
REDIS_DB=0

HTTP_CLIENT_TIMEOUT=10s
MAX_BODY_BYTES=1048576
MAX_MULTIPART_MEMORY=8388608

METRICS_ENABLE=true
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=storage

DISCORD_BOT_TOKEN=
DISCORD_GUILD_ID=

# Optional: enables the /revenue SaaS figures. Leave both empty to keep the
# command reporting "SaaS revenue: unavailable". Never commit a real token.
# SAAS_REVENUE_URL=http://skill-issues-saas-be:8080/api/v1/admin/reports/finance-overview
# SAAS_REVENUE_TOKEN=

# Production host only (docker-compose.prod.yml). Do not commit .env.production.
# GHCR_USERNAME=
# GHCR_PULL_TOKEN=
